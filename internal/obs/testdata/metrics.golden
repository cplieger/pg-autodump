# HELP pg_autodump_dump_ok 1 unless the database's latest dump failed; 0 for every database after a restart that read a failed last-run record.
# TYPE pg_autodump_dump_ok gauge
pg_autodump_dump_ok{db="not-a-spec",server="_5432"} 0
pg_autodump_dump_ok{db="app",server="down_5432"} 0
pg_autodump_dump_ok{db="app",server="h1_5432"} 1
pg_autodump_dump_ok{db="billing",server="h2_5433"} 1
# HELP pg_autodump_dump_duration_seconds How long the database's latest dump attempt took; absent until the first attempt since the process started.
# TYPE pg_autodump_dump_duration_seconds gauge
pg_autodump_dump_duration_seconds{db="app",server="down_5432"} 0.25
pg_autodump_dump_duration_seconds{db="app",server="h1_5432"} 2
pg_autodump_dump_duration_seconds{db="billing",server="h2_5433"} 3.125
# HELP pg_autodump_build_info Always 1; version is the running build's release tag.
# TYPE pg_autodump_build_info gauge
pg_autodump_build_info{version="v1.2.3"} 1
# HELP pg_autodump_last_cycle_timestamp_seconds Unix time the latest dump cycle ended; read from the last-run record at start.
# TYPE pg_autodump_last_cycle_timestamp_seconds gauge
pg_autodump_last_cycle_timestamp_seconds 1.7938890005e+09
# HELP pg_autodump_last_cycle_ok 1 when every database dumped and verified in the latest cycle, else 0.
# TYPE pg_autodump_last_cycle_ok gauge
pg_autodump_last_cycle_ok 0
# HELP pg_autodump_cycle_deadline_timestamp_seconds Unix time by which the next fully successful dump cycle is due; 0 while DUMP_INTERVAL is off.
# TYPE pg_autodump_cycle_deadline_timestamp_seconds gauge
pg_autodump_cycle_deadline_timestamp_seconds 1794060000
# HELP pg_autodump_newest_dump_timestamp_seconds Modification time of the database's newest verified dump under DUMP_DIR; absent until its first dump.
# TYPE pg_autodump_newest_dump_timestamp_seconds gauge
pg_autodump_newest_dump_timestamp_seconds{db="app",server="h1_5432"} 1.79375760025e+09
pg_autodump_newest_dump_timestamp_seconds{db="billing",server="h2_5433"} 1.79375769025e+09
# HELP pg_autodump_dump_bytes Size in bytes of the database's newest verified dump under DUMP_DIR; absent until its first dump.
# TYPE pg_autodump_dump_bytes gauge
pg_autodump_dump_bytes{db="app",server="h1_5432"} 9
pg_autodump_dump_bytes{db="billing",server="h2_5433"} 18
# HELP pg_autodump_dump_dir_free_bytes Bytes free to the container user on the filesystem holding DUMP_DIR.
# TYPE pg_autodump_dump_dir_free_bytes gauge
pg_autodump_dump_dir_free_bytes @FREE_BYTES@
